# Prompt Pilot - Environment Configuration Example

# Optional shared authentication token for securing the bridge server
# Matches the "Security Auth Token" configured in the Chrome side panel
PROMPT_PILOT_TOKEN=your-secret-token-here

# Optional remote WebSocket bridge URL for remote CLI or MCP clients
# Default remote bridge endpoint:
PROMPT_PILOT_REMOTE=wss://prompt-pilot.appkh.online

# Local bridge server port (default: 9988)
PORT=9988
