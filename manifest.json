{
  "manifest_version": 3,
  "name": "Prompt Pilot",
  "version": "1.0.0",
  "description": "Queue and send bulk prompts from a Chrome side panel to popular AI chat sites.",
  "permissions": ["activeTab", "sidePanel", "storage", "tabs", "scripting", "debugger", "downloads", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Prompt Pilot" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
